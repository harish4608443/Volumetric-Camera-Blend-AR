// Mobile-Optimized TSDF Volume Integration Compute Shader
// Uses RHalf (16-bit float) format for mobile compatibility
#pragma kernel IntegrateDepth
#pragma kernel ClearVolume

// Volume parameters - Using RHalf (16-bit) for mobile performance
RWTexture3D<half> TSDFVolume;       // Single channel SDF only
RWTexture3D<half> WeightVolume;     // Separate weight volume
float3 VolumeSize;                   // Voxel dimensions
float3 VolumeOrigin;                 // World position of volume corner
float VoxelSize;                     // Size of each voxel in meters
float TruncationDistance;            // TSDF truncation distance

// Depth data
Texture2D<float> DepthTexture;
SamplerState sampler_DepthTexture;
float4x4 ViewMatrix;                 // Camera view matrix (world to camera)
float4x4 ProjectionMatrix;           // Camera projection matrix
float2 DepthResolution;
float MaxDepth;                      // Maximum valid depth value

[numthreads(4,4,4)]
void IntegrateDepth(uint3 id : SV_DispatchThreadID)
{
    // Check bounds
    if (any(id >= uint3(VolumeSize)))
        return;
    
    // Convert voxel to world position
    float3 voxelWorld = VolumeOrigin + (float3(id) + 0.5) * VoxelSize;
    
    // Transform to camera space
    float4 voxelCam = mul(ViewMatrix, float4(voxelWorld, 1.0));
    
    // Behind camera check
    if (voxelCam.z <= 0)
        return;
    
    // Project to screen space
    float4 voxelClip = mul(ProjectionMatrix, voxelCam);
    float3 voxelNDC = voxelClip.xyz / voxelClip.w;
    
    // Convert to UV coordinates [0,1]
    float2 uv = voxelNDC.xy * 0.5 + 0.5;
    
    // Check if within depth image bounds
    if (any(uv < 0) || any(uv > 1))
        return;
    
    // Sample depth
    float measuredDepth = DepthTexture.SampleLevel(sampler_DepthTexture, uv, 0).r;
    
    // Validate depth
    if (measuredDepth < 0.01 || measuredDepth > MaxDepth)
        return;
    
    // Compute signed distance
    float sdf = measuredDepth - voxelCam.z;
    
    // Apply truncation
    if (sdf < -TruncationDistance)
        return;
    
    // Normalize to [-1, 1]
    sdf = clamp(sdf / TruncationDistance, -1.0, 1.0);
    
    // Read current values
    float currentSDF = TSDFVolume[id];
    float currentWeight = WeightVolume[id];
    
    // Weighted average update
    float newWeight = 1.0;
    float totalWeight = currentWeight + newWeight;
    float updatedSDF = (currentSDF * currentWeight + sdf * newWeight) / totalWeight;
    
    // Cap weight to prevent overflow
    totalWeight = min(totalWeight, 100.0h);
    
    // Write back
    TSDFVolume[id] = updatedSDF;
    WeightVolume[id] = totalWeight;
}

[numthreads(4,4,4)]
void ClearVolume(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= uint3(VolumeSize)))
        return;
    
    TSDFVolume[id] = 1.0h;      // Empty space (far from surface)
    WeightVolume[id] = 0.0h;    // No observations
}

